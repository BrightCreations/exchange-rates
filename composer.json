{
    "type": "library",
    "name": "brightcreations/exchange-rates",
    "description": "A Laravel package for fetching exchange rates from various sources.",
    "version": "v0.11.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Bright Creations",
            "email": "kareem.shaaban@brightcreations.com"
        }
    ],
    "keywords": [
        "laravel",
        "exchange rates",
        "currency conversion"
    ],
    "autoload": {
        "psr-4": {
            "BrightCreations\\ExchangeRates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrightCreations\\ExchangeRates\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrightCreations\\ExchangeRates\\ExchangeRatesServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "brick/math": ">=0.11 <2.0",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "pragmarx/countries": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "vlucas/phpdotenv": "^5.6",
        "laravel/pint": "^1.0 || ^1.25"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "pint": "./vendor/bin/pint"
    }
}
